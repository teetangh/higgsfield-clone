generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Generation {
  id               String   @id @default(cuid())
  prompt           String
  model            String
  provider         String
  size             String
  batchSize        Int      @default(1)
  status           String   @default("pending")
  error            String?
  settingsSnapshot String?
  estimatedCostUsd Float?
  actualCostUsd    Float?
  createdAt        DateTime @default(now())
  images           Image[]
}

model Image {
  id           String     @id @default(cuid())
  generationId String
  generation   Generation @relation(fields: [generationId], references: [id], onDelete: Cascade)
  type         String
  relativePath String
  mimeType     String
  width        Int?
  height       Int?
  batchIndex   Int?
  sortOrder    Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([generationId])
}

model ProfileSettings {
  id                 String   @id @default("default")
  displayName        String   @default("Studio")
  billingMode        String   @default("prepaid")
  manualBalanceUsd   Float?
  budgetLimitUsd     Float?
  budgetAlertPercent Int      @default(80)
  updatedAt          DateTime @updatedAt
}

model UsageLog {
  id           String   @id @default(cuid())
  generationId String?
  model        String
  imageCount   Int
  estimatedUsd Float
  createdAt    DateTime @default(now())
}
