# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build & cache
/.next/
/out/
/build
/coverage
*.tsbuildinfo

# Environment & secrets (NEVER commit)
.env
.env.*
!.env.example

# Local database (contains your generation history)
/prisma/*.db
/prisma/*.db-journal
/dev.db
/dev.db-journal
*.db
*.db-journal

# User-generated content (prompts, images, outputs)
/storage/
!/storage/generations/.gitkeep

# Root-level media (never commit accidental drops)
/*.png
/*.jpg
/*.jpeg
/*.webp
/*.gif

# Generated Prisma client (rebuilt via postinstall)
/app/generated/

# IDE & OS
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~

# Logs & debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# Deployment
.vercel

# Cursor / local assets (screenshots, uploads from chat)
/assets/
.cursor/

# Certificates & keys
*.pem
*.key
*.p12
credentials.json
secrets.json
service-account*.json

# Next.js auto-generated
next-env.d.ts
