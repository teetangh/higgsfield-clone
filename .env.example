# ByteDance API provider: "byteplus" | "volcengine"
ARK_PROVIDER=byteplus
ARK_API_KEY=

# Optional override for API base URL (without /images/generations suffix)
# byteplus:   https://ark.ap-southeast.bytepluses.com/api/v3
# volcengine: https://ark.cn-beijing.volces.com/api/v3
ARK_BASE_URL=

DATABASE_URL="file:./dev.db"

# Sentry error monitoring (optional — defaults to wizard DSN if unset)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
